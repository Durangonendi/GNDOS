# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir.
# .env asla git'e eklenmez (.gitignore'da).

PORT=8787

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service role sadece backend'de kullanılır, frontend'e ASLA gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# İleride Faz 4-7'de kullanılacak (şimdilik boş bırakılabilir)
ANTHROPIC_API_KEY=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
